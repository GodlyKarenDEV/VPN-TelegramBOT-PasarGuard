# =============================================================
# 🤖 تنظیمات اصلی ربات تلگرام (Telegram Bot Settings)
# =============================================================
# توکن دریافتی از BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# یوزرنیم ربات بدون علامت @ (جهت تولید لینک‌های رفرال و استارت)
BOT_USERNAME=YourBotUsername

# آیدی کانال رسمی جهت قفل عضویت اجباری (با @ یا آیدی عددی)
CHANNEL_ID=@YourChannel

# آیدی پشتیبانی تلگرام جهت ارتباط کاربران (بدون @)
SUPPORT_USERNAME=YourSupportUsername

# فهرست یوزرنیم‌های ادمین‌های اصلی (جداشده با کاما و بدون @)
ADMIN_USERNAMES=admin1,admin2

# =============================================================
# 💳 تنظیمات پرداخت کارت‌به‌کارت (Payment Settings)
# =============================================================
# شماره کارت بانکی جهت نمایش به کاربران برای ارسال فیش
CARD_NUMBER=6037990000000000

# نام و نام خانوادگی دارنده حساب بانکی
CARD_HOLDER=نام و نام خانوادگی دارنده کارت

# =============================================================
# 🗄 تنظیمات پایگاه داده MySQL (MySQL Database Settings)
# =============================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_NAME=telegram_bot
DB_PASS=your_strong_password

# کلید ۳۲ کاراکتری تصادفی جهت رمزنگاری متقارن داده‌ها (AES-256-GCM)
ENCRYPTION_KEY=Your32CharacterSecretKey12345678

# =============================================================
# 🌐 تنظیمات اتصال به پنل پاسارگاد (Pasargad Panel v5.4.1 Settings)
# =============================================================
# آدرس پنل به همراه پورت (بدون اسلش پایانی)
PANEL_URL=https://panel.example.com:8000

# نام کاربری ادمین پنل
PANEL_USER=admin

# رمز عبور ادمین پنل
PANEL_PASS=your_panel_password

# شناسه‌های گروه‌های فعال در سرور (جداشده با کاما)
PANEL_GROUP_IDS=1,2